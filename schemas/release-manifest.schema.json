{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/skunkworks-academy/academy-validation/schemas/release-manifest.schema.json",
  "title": "Skunkworks Academy Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repository", "commit", "artifact", "promotion"],
  "properties": {
    "schemaVersion": {"const": 1},
    "repository": {
      "type": "string",
      "pattern": "^skunkworks-academy/[a-z0-9._-]+$"
    },
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "digest", "immutableTag"],
      "properties": {
        "image": {
          "type": "string",
          "pattern": "^ghcr\\.io/skunkworks-academy/[a-z0-9._-]+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "immutableTag": {"type": "string", "minLength": 1},
        "sbom": {"type": ["string", "null"]},
        "provenance": {"type": ["string", "null"]}
      }
    },
    "promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "approvedBy", "approvedAt"],
      "properties": {
        "environment": {
          "enum": ["development", "test", "staging", "production"]
        },
        "approvedBy": {"type": "string", "minLength": 1},
        "approvedAt": {"type": "string", "format": "date-time"},
        "sourceEnvironment": {
          "type": ["string", "null"],
          "enum": [null, "development", "test", "staging"]
        }
      }
    }
  }
}
